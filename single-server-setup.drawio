        <mxCell id="rFC9jVvg-BDtOJWrwG7b-17" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#333333;" value="1. hash(server) places each server on the ring&lt;br&gt;2. hash(client IP or key) places each request&lt;br&gt;3. walk clockwise → first server = owner&lt;br&gt;    (same client → same server: sticky)&lt;br&gt;&lt;br&gt;Adding Server 4: only keys between&lt;br&gt;Server 2 and Server 4 move (client B).&lt;br&gt;Everything else stays put." vertex="1">
          <mxGeometry height="131" width="352" x="620" y="169" as="geometry" />
        </mxCell>
